# Copy to .env. Placeholders only.
IMAGEGUARD_ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API (production: your exact frontend URL)
IMAGEGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IMAGEGUARD_MAX_UPLOAD_BYTES=10485760
IMAGEGUARD_MAX_IMAGE_PIXELS=16000000
IMAGEGUARD_ARTIFACT_TTL_SECONDS=900
IMAGEGUARD_RATE_LIMIT_PER_MINUTE=60
